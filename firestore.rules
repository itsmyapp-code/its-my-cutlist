rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own profiles; admin accounts can list and read/write all profiles
    match /users/{userId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == userId || 
        request.auth.token.email == 'martin@cozens.me.uk' || 
        request.auth.token.email == 'martincozens@gmail.com'
      );
      allow list: if request.auth != null && (
        request.auth.token.email == 'martin@cozens.me.uk' || 
        request.auth.token.email == 'martincozens@gmail.com'
      );
    }
    
    // Shared workshop inventory (offcuts)
    match /offcuts_inventory/{offcutId} {
      allow read, write: if request.auth != null;
    }
    
    // Deployed jobs / cutlists
    match /jobs/{jobId} {
      allow read, write: if request.auth != null;
    }
  }
}
